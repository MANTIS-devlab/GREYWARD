    {"surface":"wallpaper-variant","consumer":"DMS wallpaper picker","source":"branding/wallpaper/greyward-wallpaper-2109-4k.jpg","outputs":[],"validation":"3840x2160 JPG; canonical logo applied"},
    {"surface":"wallpaper-collection","consumer":"DMS wallpaper picker","source":"branding/wallpaper","outputs":[],"validation":"two JPG wallpapers; canonical logo applied"},
