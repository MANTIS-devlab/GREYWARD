{
  "schema": "greyward.production-system/v1",
  "status": "active-development",
  "release": {
    "version": "0.5.3",
    "codename": "Sophon"
  },
  "runtime": {
    "compositor": "labwc",
    "fallbackCompositor": "hyprland",
    "shell": "DankMaterialShell",
    "securityCenter": "greyward-security-center",
