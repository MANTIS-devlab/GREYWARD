    "securityCenterContract": "security-center-contract.tsv",
    "securityCenterBuildManifest": "artifacts/security-center-build-manifest.tsv",
    "imageInputStager": "../image/build.sh",
    "dmsReleaseManifest": "dms-release.json",
    "dmsRuntimePackage": "greyward-dms",
    "sessionPolicyPackage": "greyward-session",
    "officeSourceManifest": "office-source/packaging/greyward-office/source.json",
    "officePackages": ["greyward-writer", "greyward-sheets", "greyward-pdf", "greyward-slides"]
  },
  "notProduction": [
    "environment/development",
    "tools/greyward-dev",
    "Hyper-V communicator access",
    "developer credentials",
    "boot rollback prototype"
