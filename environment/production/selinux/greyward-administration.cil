; Remove inherited Fedora helper access before asserting the protected boundary.
(deny greyward_as_ordinary greyward_admin_exec_t (file (execute entrypoint)))
(deny greyward_as_ordinary greyward_admin_password_exec_t (file (execute entrypoint)))
(deny greyward_as_ordinary greyward_admin_t (process (transition dyntransition ptrace signal sigkill sigstop)))
(deny greyward_as_ordinary greyward_admin_sudo_t (process (transition dyntransition ptrace signal sigkill sigstop)))
(deny greyward_as_ordinary greyward_admin_password_t (process (transition dyntransition ptrace signal sigkill sigstop)))
(deny greyward_as_ordinary greyward_admin_t (file (open read write append)))
(deny greyward_as_ordinary greyward_admin_sudo_t (file (open read write append)))
(deny greyward_as_ordinary greyward_admin_password_t (file (open read write append)))
(deny greyward_as_ordinary greyward_admin_t (fd (use)))
(deny greyward_as_ordinary greyward_admin_sudo_t (fd (use)))
(deny greyward_as_ordinary greyward_admin_password_t (fd (use)))
(deny greyward_as_ordinary greyward_admin_t (fifo_file (open read write append)))
(deny greyward_as_ordinary greyward_admin_sudo_t (fifo_file (open read write append)))
(deny greyward_as_ordinary greyward_admin_password_t (fifo_file (open read write append)))
(deny greyward_as_ordinary greyward_admin_devpts_t (chr_file (open read write append ioctl)))
(deny greyward_as_ordinary greyward_admin_runtime_t (dir (open read write add_name remove_name)))
(deny greyward_as_ordinary greyward_admin_runtime_t (file (open read write append execute)))
(deny greyward_as_ordinary greyward_admin_shm_t (file (open read write append map)))
(deny greyward_as_ordinary sysadm_t (process (ptrace signal sigkill sigstop)))
(deny greyward_as_ordinary sysadm_t (file (open read write append)))
(deny greyward_as_ordinary sysadm_t (fd (use)))
(deny greyward_as_ordinary greyward_admin_t (process (setpgid)))
(deny greyward_as_ordinary greyward_admin_sudo_t (process (setpgid)))
(deny greyward_as_ordinary greyward_admin_password_t (process (setpgid)))
(deny greyward_as_ordinary sysadm_t (process (setpgid)))
(deny greyward_as_ordinary sysadm_sudo_t (process (transition dyntransition ptrace signal sigkill sigstop setpgid)))
(deny greyward_as_ordinary sysadm_sudo_t (file (open read write append)))
(deny greyward_as_ordinary sysadm_sudo_t (fd (use)))
(deny greyward_as_ordinary sysadm_sudo_t (fifo_file (open read write append)))
(neverallow greyward_as_ordinary greyward_admin_devpts_t (chr_file (open read write append ioctl)))
(neverallow greyward_as_ordinary greyward_admin_runtime_t (file (open read write append execute)))
