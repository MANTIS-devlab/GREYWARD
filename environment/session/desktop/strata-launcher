#!/usr/bin/sh
set -eu
/usr/local/libexec/greyward-files-seed strata
# Root-packaged icon-only overlay: preserve the verified upstream executable
# and all non-icon resources. Do not inherit an arbitrary resource overlay.
export G_RESOURCE_OVERLAYS=/io/github/lgse/Strata/icons=/usr/share/greyward/files/strata-resources/icons
exec /usr/libexec/greyward/files/strata "$@"
