#!/usr/bin/python3
"""Session-scoped backend capability and shell IPC readiness check (no settings)."""
import json
import os
from pathlib import Path
import socket
import stat
import subprocess
import time


def request(path, method, params=None):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(12)
        connection.connect(str(path))
        connection.sendall((json.dumps({'id': 1, 'method': method, 'params': params}) + '\n').encode())
        reader = connection.makefile('rb')
        for _ in range(100):
            line = reader.readline()
            if not line:
                raise ValueError('Backend disconnected')
            result = json.loads(line)
            if result.get('id') == 1:
                if result.get('error'):
                    raise ValueError(str(result['error']))
                return result['result']
        raise ValueError('Missing response')


def validate_lock_status(lock):
    fields = ('loginctlLocked', 'shouldLock', 'sessionLockSecure')
    if not isinstance(lock, dict) or any(type(lock.get(key)) is not bool for key in fields):
        raise ValueError('Native lock state is unavailable')
    if (lock['loginctlLocked'] or lock['shouldLock']) and not lock['sessionLockSecure']:
        raise ValueError('Native lock surface is not secure or is awaiting restoration')


def check():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    explicit = os.environ.get('DMS_SOCKET')
    candidates = [Path(explicit)] if explicit else list(runtime.glob('danklinux-*.sock'))
    selected = []
    for path in candidates:
        info = path.stat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
            raise ValueError('Untrusted backend socket')
        try:
            data = request(path, 'getServerInfo')
            selected.append((path, data))
        except (OSError, ValueError):
            continue
    if len(selected) != 1:
        raise ValueError('Expected one ready DMS backend on this session bus')
    path, data = selected[0]
    if data.get('apiVersion') != 34 or 'dgop' not in data.get('capabilities', []):
        raise ValueError('Incompatible DMS API/capabilities')
    snapshot = request(path, 'dgop.meta', {'modules': ['network']})
    if not isinstance(snapshot, dict) or 'network' not in snapshot:
        raise ValueError('Missing internal network sampler data')
    pong = request(path, 'ping')
    if not isinstance(pong, dict) or pong.get('pong') is not True:
        raise ValueError('Backend ping failed')
    try:
        output = subprocess.check_output(['/usr/local/bin/greyward-dms', 'ipc', 'call', 'settings', 'get', 'customPowerActionLock'], text=True, timeout=12)
    except subprocess.TimeoutExpired as error:
        raise ValueError('Shell IPC readiness timed out') from error
    if json.loads(output.strip()) != '':
        raise ValueError('Shell IPC/lock routing is not ready')
    lock = json.loads(subprocess.check_output(
        ['/usr/local/bin/greyward-dms', 'ipc', 'call', 'lock', 'status'], text=True, timeout=12))
    validate_lock_status(lock)
    print(json.dumps({'state': 'READY', 'apiVersion': data['apiVersion'], 'internalDgop': True,
                      'sampleReceivedMonotonic': time.monotonic(), 'pong': True, 'shellIpc': True,
                      'nativeLockSecure': lock.get('sessionLockSecure') is True}))


if __name__ == '__main__':
    try:
        check()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(json.dumps({'state': 'DEGRADED', 'reason': str(error)}))
        raise SystemExit(1)
