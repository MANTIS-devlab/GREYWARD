#!/usr/bin/python3 -I
"""Seed app-specific defaults; leave established user choices and layouts intact."""
import os
from pathlib import Path
import sys

ASSETS = Path('/usr/share/greyward/files')


def seed(destination, content):
    destination.parent.mkdir(parents=True, exist_ok=True)
    try:
        descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return
    with os.fdopen(descriptor, 'wb') as stream:
        stream.write(content)


def main():
    import pwd
    if os.getuid() == 0 or sys.argv[1:] not in (['strata'], ['desktop']):
        raise SystemExit('Use this launcher as the ordinary desktop user.')
    home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(home / '.config')))
    if not config.is_absolute():
        raise SystemExit('XDG_CONFIG_HOME must be absolute.')
    if sys.argv[1] == 'desktop':
        seed(config / 'pcmanfm-qt/greyward/settings.conf', (ASSETS / 'settings.conf').read_bytes())
    else:
        seed(config / 'strata/themes/greyward-obsidian.toml', (ASSETS / 'obsidian.toml').read_bytes())
        seed(config / 'strata/settings.toml',
             b'mode = "theme"\ntheme = "greyward-obsidian"\nelement_glow = false\n')


if __name__ == '__main__':
    main()
