#!/usr/bin/python3 -I
"""Create user-owned shortcuts from verified, installed desktop entries only."""
import argparse
import configparser
import json
import os
from pathlib import Path
import re
import stat

ROOTS = (Path('/usr/share/applications'), Path('/usr/local/share/applications'),
         Path('/var/lib/flatpak/exports/share/applications'))
LIMIT = 262144


def installed_launcher(identifier, roots=ROOTS):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,254}', identifier):
        raise ValueError('No verified installed launcher matches this application.')
    name = identifier if identifier.endswith('.desktop') else identifier + '.desktop'
    for root in roots:
        candidate = root / name
        if not candidate.exists():
            continue
        resolved = candidate.resolve(strict=True)
        # Root-controlled export symlinks are supported. User-writable launchers
        # never gain trust by supplying an application ID or copying a filename.
        for parent in (resolved.parent, *resolved.parents):
            info = parent.stat()
            if info.st_uid != 0 or info.st_mode & 0o022:
                raise ValueError('The launcher location is not trusted.')
        descriptor = os.open(resolved, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
        try:
            info = os.fstat(descriptor)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
                    info.st_mode & 0o022 or info.st_size > LIMIT):
                raise ValueError('The installed launcher is not trusted.')
            content = os.read(descriptor, LIMIT + 1)
        finally:
            os.close(descriptor)
        config = configparser.ConfigParser(interpolation=None, strict=True)
        config.optionxform = str
        config.read_string(content.decode('utf-8'))
        entry = config['Desktop Entry']
        if (entry.get('Type') != 'Application' or not entry.get('Exec') or
                entry.get('Hidden', 'false').lower() == 'true'):
            raise ValueError('This entry cannot launch an application.')
        return name, entry.get('Name', identifier), content
    raise ValueError('No verified installed launcher matches this application.')


def desktop_directory():
    import pwd
    home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(home / '.config')))
    settings = config / 'user-dirs.dirs'
    if settings.exists():
        for line in settings.read_text(encoding='utf-8').splitlines():
            match = re.fullmatch(r'XDG_DESKTOP_DIR="([^"\n]+)"', line.strip())
            if match:
                value = match[1].replace('${HOME}', str(home)).replace('$HOME', str(home))
                if '$' in value or not Path(value).is_absolute() or Path(value) == home:
                    raise ValueError('The desktop directory is disabled or invalid.')
                return Path(value)
    return home / 'Desktop'


def create_shortcut(name, content, desktop):
    desktop.mkdir(parents=True, exist_ok=True)
    directory = os.open(desktop, os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))
    try:
        info = os.fstat(directory)
        if info.st_uid != os.getuid():
            raise ValueError('The desktop directory is not owned by this user.')
        for suffix in range(1000):
            candidate = name if suffix == 0 else name[:-8] + f'-{suffix + 1}.desktop'
            try:
                fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                             0o700, dir_fd=directory)
            except FileExistsError:
                # Reuse an unchanged user-owned shortcut. Never follow or
                # overwrite an existing symlink or a different file.
                try:
                    old = os.open(candidate, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0),
                                  dir_fd=directory)
                    try:
                        existing = os.fstat(old)
                        if (stat.S_ISREG(existing.st_mode) and existing.st_uid == os.getuid()
                                and existing.st_size <= LIMIT and os.read(old, LIMIT + 1) == content):
                            return desktop / candidate, False
                    finally:
                        os.close(old)
                except OSError:
                    pass
                continue
            try:
                with os.fdopen(fd, 'wb') as stream:
                    stream.write(content)
                    stream.flush()
                    os.fsync(stream.fileno())
            except BaseException:
                os.unlink(candidate, dir_fd=directory)
                raise
            return desktop / candidate, True
        raise ValueError('Too many conflicting shortcut names.')
    finally:
        os.close(directory)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('operation', choices=('check', 'create'))
    parser.add_argument('identifier')
    args = parser.parse_args()
    try:
        if os.getuid() == 0:
            raise ValueError('Desktop shortcuts must be created by the desktop user.')
        name, display, content = installed_launcher(args.identifier)
        result = {'available': True, 'name': display}
        if args.operation == 'create':
            destination, created = create_shortcut(name, content, desktop_directory())
            # The copied entry is verified, but preserve PCManFM's native
            # explicit trust review rather than trusting arbitrary executables.
            result.update(created=created, path=str(destination), trustReview=True)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (OSError, ValueError, KeyError, configparser.Error) as error:
        print(json.dumps({'available': False, 'reason': str(error)}))
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
