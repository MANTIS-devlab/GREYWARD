#!/usr/bin/python3
"""Request the canonical native DMS lock and wait for Wayland confirmation."""
import json
from pathlib import Path
import subprocess
import time


def lock(cli='/usr/local/bin/greyward-dms', timeout=10, protected_authentication=False):
    request = ['/usr/bin/greyward-guard', 'lock'] if protected_authentication else [cli, 'ipc', 'call', 'lock', 'lock']
    status = ['/usr/bin/greyward-guard', 'lock-status'] if protected_authentication else [cli, 'ipc', 'call', 'lock', 'isLocked']
    subprocess.run(request, check=True, timeout=timeout)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        remaining = max(0.1, deadline - time.monotonic())
        output = subprocess.check_output(status, text=True, timeout=remaining)
        if json.loads(output.strip()) is True:
            return
        time.sleep(0.1)
    raise RuntimeError('DMS did not confirm a secure Wayland lock')


if __name__ == '__main__':
    try:
        subject = Path('/proc/self/attr/current').read_text().strip('\0\n')
        lock(protected_authentication=subject == 'greyward_guard_u:greyward_guard_r:greyward_guard_t:s0')
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        raise SystemExit(str(error))
