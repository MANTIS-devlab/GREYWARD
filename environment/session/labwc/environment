XDG_CURRENT_DESKTOP=Labwc:GREYWARD
XDG_SESSION_DESKTOP=labwc
XDG_DATA_DIRS=/usr/local/share:/var/lib/flatpak/exports/share:/usr/share
# Standard French AZERTY keyboard for the Labwc/wlroots session.
XKB_DEFAULT_MODEL=pc105
XKB_DEFAULT_LAYOUT=fr
GDK_BACKEND=wayland,x11
QT_QPA_PLATFORM=wayland;xcb
# The GREYWARD VM exposes a software-only virtual GPU. Labwc otherwise refuses
# to initialize wlroots' software renderer; real hardware sessions can omit it.
WLR_RENDERER_ALLOW_SOFTWARE=1
# The Hyper-V virtual GPU has no usable DRM/EGL device. Force wlroots' stable
# software renderer to avoid EGL/Zink damage artifacts while moving windows.
WLR_RENDERER=pixman
