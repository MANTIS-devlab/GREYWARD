[Default Applications]
inode/directory=io.github.lgse.Strata.desktop;

# GREYWARD default communication and web applications.
x-scheme-handler/mailto=io.github.hkdb.Aerion.desktop;
x-scheme-handler/http=com.brave.Browser.desktop;
x-scheme-handler/https=com.brave.Browser.desktop;
text/html=com.brave.Browser.desktop;
application/xhtml+xml=com.brave.Browser.desktop;
text/plain=org.gnome.TextEditor.desktop;
application/pdf=systems.mantis.greyward.PDF.desktop;

# Local image viewing belongs to the native viewer, not the web browser.
image/png=org.gnome.Loupe.desktop;
image/jpeg=org.gnome.Loupe.desktop;
image/gif=org.gnome.Loupe.desktop;
image/webp=org.gnome.Loupe.desktop;
image/bmp=org.gnome.Loupe.desktop;
image/tiff=org.gnome.Loupe.desktop;
image/svg+xml=org.gnome.Loupe.desktop;
image/avif=org.gnome.Loupe.desktop;

# Native GREYWARD Office. Legacy PPT and ODP are deliberately not claimed.
# Sheets ODS import is limited; see docs/software/OFFICE_INTEGRATION.md.
application/msword=systems.mantis.greyward.Writer.desktop;
application/msword-template=systems.mantis.greyward.Writer.desktop;
application/vnd.ms-word.document.macroEnabled.12=systems.mantis.greyward.Writer.desktop;
application/vnd.ms-word.template.macroEnabled.12=systems.mantis.greyward.Writer.desktop;
application/vnd.openxmlformats-officedocument.wordprocessingml.document=systems.mantis.greyward.Writer.desktop;
application/vnd.openxmlformats-officedocument.wordprocessingml.template=systems.mantis.greyward.Writer.desktop;
application/vnd.oasis.opendocument.text=systems.mantis.greyward.Writer.desktop;
application/rtf=systems.mantis.greyward.Writer.desktop;
text/rtf=systems.mantis.greyward.Writer.desktop;
application/vnd.ms-excel=systems.mantis.greyward.Sheets.desktop;
application/vnd.ms-excel.sheet.macroEnabled.12=systems.mantis.greyward.Sheets.desktop;
application/vnd.ms-excel.sheet.binary.macroEnabled.12=systems.mantis.greyward.Sheets.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=systems.mantis.greyward.Sheets.desktop;
application/vnd.oasis.opendocument.spreadsheet=systems.mantis.greyward.Sheets.desktop;
text/csv=systems.mantis.greyward.Sheets.desktop;
text/tab-separated-values=systems.mantis.greyward.Sheets.desktop;
application/x-deckcraft=systems.mantis.greyward.Slides.desktop;
application/vnd.openxmlformats-officedocument.presentationml.presentation=systems.mantis.greyward.Slides.desktop;
application/vnd.openxmlformats-officedocument.presentationml.slideshow=systems.mantis.greyward.Slides.desktop;
application/vnd.openxmlformats-officedocument.presentationml.template=systems.mantis.greyward.Slides.desktop;
