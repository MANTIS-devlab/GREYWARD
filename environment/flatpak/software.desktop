[Desktop Entry]
Type=Application
Name=Software
Comment=Discover and install applications
Exec=/usr/local/libexec/greyward-software
Terminal=false
Categories=Settings;PackageManager;
Icon=/usr/share/icons/hicolor/scalable/apps/greyward-software.svg
StartupNotify=true
StartupWMClass=io.github.kolunmi.Bazaar
X-GNOME-UsesNotifications=true
NoDisplay=false
