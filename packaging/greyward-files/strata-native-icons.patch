+// SPDX-License-Identifier: MIT
+//! Bounded display metadata; no launcher command is evaluated.
+use gtk::{gio, glib, prelude::*};
+use std::{fs::OpenOptions, io::Read, os::unix::fs::OpenOptionsExt, path::Path};
+
+pub(super) fn bounded_open(path: &Path, limit: usize) -> Option<(std::fs::File, std::fs::Metadata)> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NONBLOCK | libc::O_CLOEXEC)
+        .open(path)
+        .ok()?;
+    let stat = file.metadata().ok()?;
+    if !stat.is_file() || stat.len() > limit as u64 {
+        return None;
+    }
+    Some((file, stat))
+}
+
+fn bounded_file(path: &Path, limit: usize) -> Option<Vec<u8>> {
+    let (file, _) = bounded_open(path, limit)?;
+    let mut bytes = Vec::new();
+    file.take(limit as u64 + 1).read_to_end(&mut bytes).ok()?;
+    (bytes.len() <= limit).then_some(bytes)
+}
+
+pub(super) fn launcher_icon(path: &Path) -> Option<gio::Icon> {
+    let bytes = bounded_file(path, 65536)?;
+    let key = glib::KeyFile::new();
+    key.load_from_data(std::str::from_utf8(&bytes).ok()?, glib::KeyFileFlags::NONE)
+        .ok()?;
+    let kind = key.string("Desktop Entry", "Type").ok()?;
+    if kind != "Application" && kind != "Link" {
+        return None;
+    }
+    let name = key.string("Desktop Entry", "Icon").ok()?;
+    if name.is_empty() || name.len() > 512 {
+        return None;
+    }
+    if name.starts_with('/') {
+        Some(gio::FileIcon::new(&gio::File::for_path(name.as_str())).upcast())
+    } else if !name.contains('/') && !name.contains(':') {
+        Some(gio::ThemedIcon::new(&name).upcast())
+    } else {
+        None
+    }
+}
+
+pub(super) fn bounded_png(bytes: &[u8]) -> bool {
+    if bytes.len() < 33
+        || &bytes[..8] != b"\x89PNG\r\n\x1a\n"
+        || bytes[8..12] != [0, 0, 0, 13]
+        || &bytes[12..16] != b"IHDR"
+    {
+        return false;
+    }
+    let width = u32::from_be_bytes(bytes[16..20].try_into().expect("checked PNG header"));
+    let height = u32::from_be_bytes(bytes[20..24].try_into().expect("checked PNG header"));
+    (1..=1024).contains(&width) && (1..=1024).contains(&height)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn icon_inputs_refuse_directories_and_oversized_files() {
+        let dir = tempfile::tempdir().expect("temporary icon input");
+        let path = dir.path().join("large");
+        std::fs::write(&path, [0u8; 65]).expect("synthetic file");
+        assert!(bounded_file(&path, 64).is_none());
+        assert!(bounded_file(dir.path(), 64).is_none());
+    }
+    #[test]
+    fn raster_icons_require_bounded_png_dimensions() {
+        let mut bytes = vec![0u8; 33];
+        bytes[..8].copy_from_slice(b"\x89PNG\r\n\x1a\n");
+        bytes[8..12].copy_from_slice(&13u32.to_be_bytes());
+        bytes[12..16].copy_from_slice(b"IHDR");
+        bytes[16..20].copy_from_slice(&64u32.to_be_bytes());
+        bytes[20..24].copy_from_slice(&64u32.to_be_bytes());
+        assert!(bounded_png(&bytes));
+        bytes[16..20].copy_from_slice(&100000u32.to_be_bytes());
+        assert!(!bounded_png(&bytes));
+        assert!(!bounded_png(b"not a PNG"));
+    }
+    #[test]
+    fn launcher_metadata_never_executes_or_establishes_trust() {
+        let dir = tempfile::tempdir().expect("temporary launcher");
+        let path = dir.path().join("example.desktop");
+        let marker = dir.path().join("must-not-exist");
+        std::fs::write(&path, format!("[Desktop Entry]\nType=Application\nName=Example\nIcon=com.example.App\nExec=/usr/bin/touch {}\n", marker.display())).expect("launcher fixture");
+        assert!(launcher_icon(&path).is_some());
+        assert!(!marker.exists());
+        std::fs::write(
+            &path,
+            "[Desktop Entry]\nType=Application\nIcon=https://example.invalid/icon.svg\n",
+        )
+        .expect("unsupported icon hint");
+        assert!(launcher_icon(&path).is_none());
+    }
+}
