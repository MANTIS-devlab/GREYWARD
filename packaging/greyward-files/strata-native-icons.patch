+// SPDX-License-Identifier: MIT
+//! Native file icons are display metadata, never launcher authorization.
+use gtk::{gdk, gio, prelude::*};
+use gdk_pixbuf::prelude::PixbufLoaderExt;
+use std::{
+    cell::RefCell,
+    io::Read,
+    os::unix::fs::MetadataExt,
+    path::Path,
+};
+
+mod input;
+use input::{bounded_open, bounded_png, launcher_icon};
+
+thread_local! {
+    static THEME: RefCell<Option<gtk::IconTheme>> = const { RefCell::new(None) };
+}
+
+pub(super) fn register() {
+    let Ok(name) = std::env::var("STRATA_NATIVE_ICON_THEME") else {
+        return;
+    };
+    if name.is_empty() || name.len() > 128 || name.contains('/') {
+        return;
+    }
+    let theme = gtk::IconTheme::new();
+    theme.set_theme_name(Some(&name));
+    // GTK may inspect themed icons during lookup. Keep that lookup restricted
+    // to administrator-owned themes; arbitrary FileIcon hints go directly
+    // through our bounded renderer below, without GTK opening them first.
+    theme.set_search_path(&[
+        Path::new("/usr/share/icons"),
+        Path::new("/usr/local/share/icons"),
+        Path::new("/usr/share/pixmaps"),
+        Path::new("/var/lib/flatpak/exports/share/icons"),
+    ]);
+    THEME.with_borrow_mut(|current| *current = Some(theme));
+}
+
+pub(crate) fn file_icon(path: &Path, size: i32, scale: i32) -> Option<gdk::Texture> {
+    let theme = THEME.with_borrow(Clone::clone)?;
+    let icon = if path.extension().is_some_and(|ext| ext == "desktop") {
+        launcher_icon(path)?
+    } else {
+        let (mime, _) = gio::content_type_guess(Some(path), None::<&[u8]>);
+        gio::content_type_get_icon(&mime)
+    };
+    let file = if let Some(file_icon) = icon.downcast_ref::<gio::FileIcon>() {
+        file_icon.file().path()?
+    } else {
+        theme
+            .lookup_by_gicon(
+                &icon,
+                size.max(16),
+                scale.max(1),
+                gtk::TextDirection::None,
+                gtk::IconLookupFlags::FORCE_REGULAR,
+            )
+            .file()?
+            .path()?
+    };
+    let (input, stat) = bounded_open(&file, 512 * 1024)?;
+    // Direct interface artwork is trusted system data, not arbitrary browser
+    // content. Personal SVG/PNG files must retain the isolated preview path.
+    if stat.uid() != 0 || stat.mode() & 0o022 != 0 {
+        return None;
+    }
+    let pixels = size.saturating_mul(scale).clamp(16, 768);
+    let key = (
+        format!(
+            "native:{}:{}:{}:{}:{}",
+            file.display(),
+            stat.dev(),
+            stat.ino(),
+            stat.mtime(),
+            stat.mtime_nsec()
+        ),
+        stat.len().to_string(),
+        pixels,
+    );
+    if let Some(texture) = super::cached_icon_texture(&key) {
+        return Some(texture);
+    }
+    let mut bytes = Vec::new();
+    input.take(512 * 1024 + 1).read_to_end(&mut bytes).ok()?;
+    if bytes.len() > 512 * 1024 {
+        return None;
+    }
+    let texture = if file.extension().is_some_and(|ext| ext == "svg") {
+        // The existing bounded vector renderer disables every image href resolver.
+        let surface = super::vector::surface(std::str::from_utf8(&bytes).ok()?, pixels)?;
+        super::texture_from_surface(&surface)?
+    } else if bounded_png(&bytes) {
+        let loader = gdk_pixbuf::PixbufLoader::with_type("png").ok()?;
+        loader.set_size(pixels, pixels);
+        loader.write(&bytes).ok()?;
+        loader.close().ok()?;
+        gdk::Texture::for_pixbuf(&loader.pixbuf()?)
+    } else {
+        return None;
+    };
+    Some(super::cache_icon_texture(key, texture))
+}
+
