+Greyward::DesktopOutputLayout& Application::desktopOutputLayout() {
+    if(!desktopOutputLayout_) {
+        desktopOutputLayout_ = std::make_unique<Greyward::DesktopOutputLayout>(
+            settings_.profileDir(profileName_) + QStringLiteral("/desktop-outputs.conf"));
+    }
+    return *desktopOutputLayout_;
+}
+
+QStringList Application::desktopOutputNames() const {
+    QStringList names;
+    for(auto screen : screens()) {
+        if(!screen->name().isEmpty() && !screen->geometry().isEmpty() && !names.contains(screen->name())) {
+            names.append(screen->name());
+        }
+    }
+    return names;
+}
+
+QString Application::desktopItemOutput(const QString& name) {
+    return desktopOutputLayout().owner(name, desktopOutputNames(),
+        primaryScreen() ? primaryScreen()->name() : QString());
+}
+
+bool Application::moveDesktopItems(const QStringList& names, const QString& output) {
+    if(!desktopOutputLayout().assign(names, output, desktopOutputNames())) {
+        return false;
+    }
+    refreshDesktopLayouts();
+    return true;
+}
+
+void Application::refreshDesktopLayouts() {
+    if(underWayland_ && enableDesktopManager_) {
+        for(auto window : std::as_const(desktopWindows_)) {
+            window->refreshOutputLayout();
+        }
+    }
+}
+
+void Application::syncWaylandDesktops() {
+    if(!underWayland_ || !enableDesktopManager_) {
+        return;
+    }
+    const auto names = desktopOutputNames();
+    QSet<QString> retained;
+    for(int i = desktopWindows_.size() - 1; i >= 0; --i) {
+        const auto name = desktopWindows_.at(i)->screenName();
+        if(!names.contains(name) || retained.contains(name)) {
+            delete desktopWindows_.takeAt(i);
+        }
+        else {
+            retained.insert(name);
+        }
+    }
+    for(auto screen : screens()) {
+        if(names.contains(screen->name()) && !retained.contains(screen->name())) {
+            desktopWindows_.append(createDesktopWindow(screens().indexOf(screen), screen->name()));
+            retained.insert(screen->name());
+        }
+    }
+    refreshDesktopLayouts();
+    qInfo() << "GREYWARD desktop outputs:" << retained.size() << names;
+}
