+
+void DesktopWindow::refreshOutputLayout() {
+    auto app = static_cast<Application*>(qApp);
+    auto& settings = app->settings();
+    const auto next = Greyward::DesktopOutputLayout::positionFile(
+        settings.profileDir(settings.profileName()), screenName_, app->desktopOutputNames());
+    if(next != positionConfigFile_) {
+        // Save using the old configuration before loading the new one. Qt may
+        // already have removed the old QScreen; never derive the save path here.
+        saveItemPositions();
+        loadItemPositions();
+    }
+    if(proxyModel_) {
+        proxyModel_->updateFilters();
+        queueRelayout();
+    }
+}
