+// Extend the existing native Properties dialog; never replace its file actions.
+static void greywardProperties(Fm::FileInfoList files) {
+    const auto selected = files.size() == 1 ? files.front() : nullptr;
+    auto dialog = Fm::FilePropsDialog::showForFiles(std::move(files));
+    auto tabs = dialog->findChild<QTabWidget*>();
+    if (!tabs || !selected || !selected->path().isNative()) return;
+    const QString path = QString::fromUtf8(selected->path().toString().get());
+    auto page = new QWidget(dialog);
+    auto layout = new QVBoxLayout(page);
+    auto label = new QLabel(QObject::tr("Loading scan information…"), page);
+    label->setTextFormat(Qt::PlainText);
+    label->setWordWrap(true);
+    layout->addWidget(label);
+    auto scan = new QPushButton(QObject::tr("Scan with GREYWARD"), page);
+    layout->addWidget(scan);
+    layout->addStretch();
+    tabs->addTab(page, QObject::tr("GREYWARD Scan"));
+    QObject::connect(scan, &QPushButton::clicked, page, [path]() {
+        QProcess::startDetached(QStringLiteral("/usr/bin/greyward-file-context"), {QStringLiteral("--scan-window"), path});
+    });
+    auto message = QDBusMessage::createMethodCall(QStringLiteral("systems.mantis.greyward.SecurityContext1"),
+        QStringLiteral("/systems/mantis/greyward/SecurityContext1"),
+        QStringLiteral("systems.mantis.greyward.SecurityContext1"), QStringLiteral("GetFileScanInfo"));
+    message << path;
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message, 4000), page);
+    QObject::connect(watcher, &QDBusPendingCallWatcher::finished, page, [label](QDBusPendingCallWatcher* watcher) {
+        QDBusPendingReply<QString> reply = *watcher;
+        const auto value = QJsonDocument::fromJson(reply.isError() ? QByteArray() : reply.value().toUtf8()).object();
+        label->setText(value.isEmpty() ? QObject::tr("Scan information unavailable") :
+            value.value(QStringLiteral("state")).toString() + QStringLiteral(" · ") +
+            value.value(QStringLiteral("validity")).toString() + QStringLiteral("\n") +
+            value.value(QStringLiteral("detail")).toString() + QStringLiteral("\n") +
+            value.value(QStringLiteral("scanned_at")).toString());
+        watcher->deleteLater();
+    });
+}
 
