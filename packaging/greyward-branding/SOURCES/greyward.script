// GREYWARD Plymouth script theme.
// Authentication remains owned by Plymouth, systemd, dracut, and cryptsetup.
// This file deliberately never registers Plymouth's raw keyboard callback: it
// receives typed characters. The only credential-adjacent input used here
// is the masked bullet count passed by Plymouth's display callback.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen.width = Window.GetWidth();
screen.height = Window.GetHeight();
screen.center_x = screen.width / 2;
screen.center_y = screen.height / 2;

state.name = "boot";
state.password_was_visible = 0;
state.ticks = 0;
state.seed = 4217;
update.progress = 0;
update.progress_known = 0;

palette.primary_r = 0.92; palette.primary_g = 0.93; palette.primary_b = 0.94;
palette.secondary_r = 0.45; palette.secondary_g = 0.48; palette.secondary_b = 0.52;
palette.platinum_r = 0.79; palette.platinum_g = 0.82; palette.platinum_b = 0.85;
palette.error_r = 0.53; palette.error_g = 0.31; palette.error_b = 0.32;

logo.image = Image("greyward-symbol-256.png");
logo.sprite = Sprite(logo.image);
title.sprite = Sprite();
support.sprite = Sprite();
baseline.sprite = Sprite();
bullets.sprite = Sprite();
state_label.sprite = Sprite();
message.sprite = Sprite();
update_bar.sprite = Sprite();
update_percent.sprite = Sprite();

glyphs[0] = "0"; glyphs[1] = "1"; glyphs[2] = "2"; glyphs[3] = "3";
glyphs[4] = "4"; glyphs[5] = "5"; glyphs[6] = "6"; glyphs[7] = "7";
glyphs[8] = "8"; glyphs[9] = "9"; glyphs[10] = "A"; glyphs[11] = "B";
glyphs[12] = "C"; glyphs[13] = "D"; glyphs[14] = "E"; glyphs[15] = "F";

// Keep the work bounded for early framebuffer renderers. The actual grid
// adapts to the display while remaining below 252 glyph sprites.
grid.columns = Math.Int(screen.width / 72);
if (grid.columns < 14) grid.columns = 14;
if (grid.columns > 28) grid.columns = 28;
grid.rows = Math.Int(screen.height / 118);
if (grid.rows < 7) grid.rows = 7;
if (grid.rows > 9) grid.rows = 9;
grid.spacing_x = 19;
grid.spacing_y = 24;
grid.width = grid.columns * grid.spacing_x;
grid.height = grid.rows * grid.spacing_y;
grid.origin_x = screen.center_x - grid.width / 2;
grid.origin_y = screen.center_y - grid.height / 2 + 34;

fun set_centered(sprite, image, y) {
  sprite.SetImage(image);
  sprite.SetX(screen.center_x - image.GetWidth() / 2);
  sprite.SetY(y);
}

fun set_text(sprite, text, r, g, b, y) {
  image = Image.Text(text, r, g, b);
  set_centered(sprite, image, y);
}

fun set_idle_copy(error) {
  set_text(title.sprite, "Unlock GREYWARD", palette.primary_r, palette.primary_g, palette.primary_b, screen.center_y - 54);
  if (error) set_text(support.sprite, "Passphrase incorrect", palette.error_r, palette.error_g, palette.error_b, screen.center_y - 11);
  else set_text(support.sprite, "Enter your passphrase to continue", palette.secondary_r, palette.secondary_g, palette.secondary_b, screen.center_y - 11);
  set_text(baseline.sprite, "--------------------", palette.platinum_r, palette.platinum_g, palette.platinum_b, screen.center_y + 48);
  title.sprite.SetOpacity(1);
  support.sprite.SetOpacity(1);
  baseline.sprite.SetOpacity(0.72);
  state_label.sprite.SetOpacity(0);
}

fun hide_idle_copy() {
  title.sprite.SetOpacity(0);
  support.sprite.SetOpacity(0);
  bullets.sprite.SetOpacity(0);
  baseline.sprite.SetOpacity(0.35);
}

fun hide_update_copy() {
  update_bar.sprite.SetOpacity(0);
  update_percent.sprite.SetOpacity(0);
}

fun hide_grid() {
  for (index = 0; grid.sprite[index]; index++) grid.sprite[index].SetOpacity(0);
}

fun show_idle(error) {
  state.name = "password";
  hide_grid();
  hide_update_copy();
  set_idle_copy(error);
  logo.sprite.SetX(screen.center_x - logo.image.GetWidth() / 2);
  logo.sprite.SetY(screen.center_y - 268);
  logo.sprite.SetOpacity(1);
  message.sprite.SetOpacity(0);
}

fun show_verifying() {
  state.name = "verifying";
  hide_idle_copy();
  hide_update_copy();
  logo.sprite.SetOpacity(0.18);
  set_text(state_label.sprite, "VERIFYING KEY", palette.primary_r, palette.primary_g, palette.primary_b, grid.origin_y - 56);
  state_label.sprite.SetOpacity(1);
  baseline.sprite.SetOpacity(0.62);
  message.sprite.SetOpacity(0);
}

fun show_success() {
  state.name = "success";
  set_text(state_label.sprite, "SECURE STORAGE UNLOCKED", palette.primary_r, palette.primary_g, palette.primary_b, grid.origin_y - 56);
  state_label.sprite.SetOpacity(1);
}

fun update_progress_bar(progress) {
  if (progress < 0) progress = 0;
  if (progress > 1) progress = 1;
  update.progress = progress;
  update.progress_known = 1;

  filled = Math.Int(progress * 28);
  update.bar_text = "[";
  for (index = 0; index < 28; index++) {
    if (index < filled) update.bar_text += "=";
    else update.bar_text += "-";
  }
  update.bar_text += "]";

  set_text(update_bar.sprite, update.bar_text, palette.platinum_r, palette.platinum_g, palette.platinum_b, screen.center_y + 142);
  set_text(update_percent.sprite, Math.Int(progress * 100) + "% complete", palette.primary_r, palette.primary_g, palette.primary_b, screen.center_y + 181);
  update_bar.sprite.SetOpacity(0.86);
  update_percent.sprite.SetOpacity(1);
}

fun show_update(progress_known) {
  state.name = "update";
  hide_grid();
  bullets.sprite.SetOpacity(0);
  baseline.sprite.SetOpacity(0);
  state_label.sprite.SetOpacity(0);
  message.sprite.SetOpacity(0);

  logo.sprite.SetX(screen.center_x - logo.image.GetWidth() / 2);
  logo.sprite.SetY(screen.center_y - 226);
  logo.sprite.SetOpacity(1);
  set_text(title.sprite, "Installing system updates", palette.primary_r, palette.primary_g, palette.primary_b, screen.center_y + 64);
  set_text(support.sprite, "Keep this computer powered on", palette.secondary_r, palette.secondary_g, palette.secondary_b, screen.center_y + 103);
  title.sprite.SetOpacity(1);
  support.sprite.SetOpacity(1);

  if (progress_known) update_progress_bar(update.progress);
  else {
    set_text(update_bar.sprite, "[----------------------------]", palette.secondary_r, palette.secondary_g, palette.secondary_b, screen.center_y + 142);
    set_text(update_percent.sprite, "Preparing update...", palette.secondary_r, palette.secondary_g, palette.secondary_b, screen.center_y + 181);
    update_bar.sprite.SetOpacity(0.54);
    update_percent.sprite.SetOpacity(1);
  }
}

fun system_update_callback(progress) {
  update.progress = progress;
  show_update(1);
}

fun update_bullets(count) {
  state.bullet_text = "";
  visible = count;
  if (visible > 24) visible = 24;
  for (index = 0; index < visible; index++) state.bullet_text += "* ";
  set_text(bullets.sprite, state.bullet_text, palette.primary_r, palette.primary_g, palette.primary_b, screen.center_y + 20);
  bullets.sprite.SetOpacity(1);
}

fun next_glyph(row, column) {
  // Decorative state only: no prompt, bullet, password, cryptsetup, or
  // key material enters the animation.
  state.seed = (state.seed * 97 + 37) % 9973;
  phase = Math.Int(state.ticks / 3 + row * 5 + column * 3 + state.seed);
  return glyphs[phase % 16];
}

fun update_verification_grid() {
  if (state.name != "verifying" && state.name != "success") return;
  for (row = 0; row < grid.rows; row++) {
    for (column = 0; column < grid.columns; column++) {
      index = row * grid.columns + column;
      if (!grid.sprite[index]) grid.sprite[index] = Sprite();
      wave = (state.ticks / 5 + row * 3 + column * 2) % 17;
      if (state.name == "success") {
        glyph = glyphs[(row + column) % 16];
        opacity = 0.24 + ((row + column) % 4) * 0.08;
      } else {
        glyph = next_glyph(row, column);
        opacity = 0.20 + wave * 0.028;
      }
      image = Image.Text(glyph, palette.platinum_r, palette.platinum_g, palette.platinum_b);
      grid.sprite[index].SetImage(image);
      grid.sprite[index].SetX(grid.origin_x + column * grid.spacing_x);
      grid.sprite[index].SetY(grid.origin_y + row * grid.spacing_y);
      grid.sprite[index].SetOpacity(opacity);
    }
  }
}

fun refresh_callback() {
  state.ticks++;
  update_verification_grid();
}

fun display_normal_callback() {
  // A safe presentation event only. GREYWARD-BOOTTEST proves its ordering
  // before it is accepted as the password-dialog dismissal transition.
  if (state.password_was_visible && state.name == "password") show_verifying();
}

fun display_password_callback(prompt, bullet_count) {
  // The callback exposes a masked count, never characters. A new empty prompt
  // after a proven verification transition is the candidate failure signal.
  if (state.name == "verifying" && bullet_count == 0) show_idle(1);
  else if (state.name != "password") show_idle(0);
  state.password_was_visible = 1;
  update_bullets(bullet_count);
}

fun display_question_callback(prompt, entry) {
  hide_grid();
  hide_update_copy();
  set_text(title.sprite, prompt, palette.primary_r, palette.primary_g, palette.primary_b, screen.center_y - 28);
  set_text(support.sprite, entry, palette.secondary_r, palette.secondary_g, palette.secondary_b, screen.center_y + 18);
  title.sprite.SetOpacity(1);
  support.sprite.SetOpacity(1);
}

fun root_mounted_callback() {
  // A presentation event only. Its success meaning is verified in BOOTTEST.
  if (state.name == "verifying") show_success();
}

fun message_callback(message) {
  // Never parse messages as authentication state.
  // This exact presentation token is emitted only by the conditional
  // /system-update unit. It carries no provider or authentication state.
  if (message == "GREYWARD system update in progress") show_update(update.progress_known);
  else if (state.name == "boot") {
    set_text(message.sprite, message, palette.secondary_r, palette.secondary_g, palette.secondary_b, screen.center_y + 166);
    message.sprite.SetOpacity(1);
  }
}

logo.sprite.SetX(screen.center_x - logo.image.GetWidth() / 2);
logo.sprite.SetY(screen.center_y - 132);
set_text(message.sprite, "Starting GREYWARD", palette.secondary_r, palette.secondary_g, palette.secondary_b, screen.center_y + 166);

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetRootMountedFunction(root_mounted_callback);
Plymouth.SetMessageFunction(message_callback);
Plymouth.SetSystemUpdateFunction(system_update_callback);
