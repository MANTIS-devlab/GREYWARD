+/* Experimental provider guard; retains the provider's LGPL-2.1-or-later license.
+ * Validate an existing named target through its descriptor, without reading
+ * content. SELinux remains responsible for every subsequent FUSE access.
+ * This check does not bind a pathname export permanently to the checked inode.
+ */
+static gboolean
+validate_named_target (int parent_fd, const char *filename, GError **error)
+{
+  int target_fd;
+  struct stat target;
+  gboolean valid;
+
+  target_fd = openat (parent_fd, filename, O_PATH | O_CLOEXEC | O_NOFOLLOW);
+  if (target_fd < 0 && errno == ENOENT)
+    return TRUE; /* Ordinary save-as into a validated writable parent. */
+
+  valid = target_fd >= 0 &&
+          fstat (target_fd, &target) == 0 &&
+          S_ISREG (target.st_mode) &&
+          faccessat (target_fd, "", R_OK | W_OK, AT_EMPTY_PATH | AT_EACCESS) == 0;
+  if (target_fd >= 0)
+    close (target_fd);
+  if (!valid)
+    g_set_error (error, XDG_DESKTOP_PORTAL_ERROR,
+                 XDG_DESKTOP_PORTAL_ERROR_INVALID_ARGUMENT,
+                 "Invalid named selection");
+  return valid;
+}
+
