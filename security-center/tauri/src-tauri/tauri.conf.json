{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GREYWARD Security Center",
  "version": "0.1.0",
  "identifier": "systems.mantis.greyward.securitycenter",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GREYWARD Security Center",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "shadow": true,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
