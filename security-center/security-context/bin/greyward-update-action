#!/usr/bin/python3
"""Fixed privileged update transaction for the GREYWARD Update Center."""
import argparse
import json
import os
import re
import subprocess
import sys
import socket
import struct
from pathlib import Path


DNF = "/usr/bin/dnf5"
FLATPAK = "/usr/bin/flatpak"
FWUPD = "/usr/bin/fwupdmgr"
OFFLINE_DIR = Path("/usr/lib/sysimage/libdnf5/offline")
SYSTEM_UPDATE_LINK = Path("/system-update")
OPTIONAL_REPO = "fedora-cisco-openh264"
OPTIONAL_PACKAGES = ("openh264", "mozilla-openh264")
PROVIDER_TIMEOUT = 1800
RPM_QUERY_TIMEOUT = 30
PACKAGE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9+_.:-]*$")
OPERATION_ID = re.compile(r"^dnf5-[0-9]{1,20}$")
MAX_DRIVER_PACKAGES = 32
HELPER = "/usr/libexec/greyward-update-action"
WORKER_SOCKET = "/run/greyward-update-worker.sock"

env = os.environ.copy()
env["LC_ALL"] = "C"
env["LANG"] = "C"


def emit(event, **values):
    print(json.dumps({"greyward_update_event": event, **values}, sort_keys=True, separators=(",", ":")), flush=True)


def run(command, *, timeout, extra_env=None):
    """Run a fixed native-provider operation without polluting the event stream."""
    command_env = env.copy()
    command_env.update(extra_env or {})
    result = subprocess.run(command, env=command_env, capture_output=True, text=True, check=False, timeout=timeout)
    if result.stdout:
        print(result.stdout, end="", file=sys.stderr)
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    return result


def optional_repo_failure(result):
    output = f"{result.stdout}\n{result.stderr}".lower()
    placeholder = subprocess.run(
        ["/usr/bin/rpm", "-q", "--quiet", "noopenh264"],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
        timeout=RPM_QUERY_TIMEOUT,
    )
    return (
        placeholder.returncode == 0
        and (OPTIONAL_REPO in output or any(package in output for package in OPTIONAL_PACKAGES))
        and ("download" in output or "mirror" in output or "repo" in output)
    )


def validate_driver_packages(packages):
    if len(packages) > MAX_DRIVER_PACKAGES or any(not PACKAGE_NAME.fullmatch(package) for package in packages):
        raise ValueError("invalid essential driver package list")
    return list(dict.fromkeys(packages))


def offline_restart_is_scheduled():
    try:
        return SYSTEM_UPDATE_LINK.is_symlink() and SYSTEM_UPDATE_LINK.resolve(strict=False) == OFFLINE_DIR
    except OSError:
        return False


def load_recovery_create():
    for path in (Path("/usr/lib/greyward-security-context"), Path(__file__).resolve().parents[1]):
        if str(path) not in sys.path:
            sys.path.insert(0, str(path))
    from greyward_security_context.recovery import create
    return create


def prepare_dnf(driver_packages):
    for path in (Path('/usr/lib/greyward-security-context'), Path(__file__).resolve().parents[1]):
        if str(path) not in sys.path:
            sys.path.insert(0, str(path))
    from greyward_security_context.dms_compatibility import dnf_options
    policy_options = dnf_options()
    if driver_packages:
        # DNF5's `do` command combines unlike actions in one transaction.  A
        # second `install --offline` command could replace the stored upgrade,
        # so keep the reviewed upgrade and essential-driver install atomic.
        command = [
            DNF, "do", "--offline", "--assumeyes",
            "--action=upgrade", "*",
            "--action=install", *driver_packages,
        ]
    else:
        command = [DNF, "upgrade", "--offline", "--assumeyes"]
    command.extend(policy_options)
    result = run(command, timeout=PROVIDER_TIMEOUT)
    optional_repo_skipped = False
    if result.returncode != 0 and optional_repo_failure(result):
        result = run([*command, f"--disablerepo={OPTIONAL_REPO}"], timeout=PROVIDER_TIMEOUT)
        optional_repo_skipped = result.returncode == 0
    if result.returncode != 0:
        return result.returncode, optional_repo_skipped

    status = run([DNF, "offline-upgrade", "status"], timeout=120)
    if status.returncode != 0:
        return status.returncode, optional_repo_skipped

    # The Update Center owns the visible restart action.  Ask DNF5 to create
    # /system-update now, while this one authenticated helper is still active,
    # but explicitly suppress its immediate reboot.  A later logind reboot can
    # then enter the prepared offline transaction without another password.
    scheduled = run(
        [DNF, "offline", "reboot", "--assumeyes"],
        timeout=120,
        extra_env={"DNF_SYSTEM_UPGRADE_NO_REBOOT": "1"},
    )
    if scheduled.returncode != 0 or not offline_restart_is_scheduled():
        return scheduled.returncode or 1, optional_repo_skipped
    return 0, optional_repo_skipped


def apply(args):
    if not OPERATION_ID.fullmatch(args.operation_id):
        raise ValueError("invalid update operation id")
    driver_packages = validate_driver_packages(args.driver_package)
    if driver_packages and not args.system:
        raise ValueError("driver packages require the system update provider")
    if not (args.system or args.system_flatpak or args.firmware):
        raise ValueError("no privileged update provider was selected")

    results = []
    recovery_point = None
    optional_repo_skipped = False
    if args.system:
        emit("phase", phase="CHECKPOINTING", message="Creating a local recovery point before the system update.")
        recovery_point = load_recovery_create()("pre-update", args.operation_id)
        if not recovery_point.get("id") or recovery_point.get("status") != "valid":
            raise RuntimeError("The recovery helper did not create a valid safety point.")
        emit("recovery", recovery_point={"id": recovery_point["id"], "status": recovery_point["status"]})
        emit("phase", phase="PREPARING_RESTART", message="Downloading and preparing the system update for the next restart.")
        returncode, optional_repo_skipped = prepare_dnf(driver_packages)
        if returncode != 0:
            emit("provider", provider="DNF5", state="DEGRADED", reason="DNF5 could not prepare the offline update.")
            return returncode
        results.append({"provider": "DNF5", "state": "SUCCESS", "reason": "The native offline system update is prepared."})
        emit("provider", **results[-1])

    if args.system_flatpak:
        emit("phase", phase="UPDATING_APPLICATIONS", message="Updating system applications through Flatpak.")
        result = run([FLATPAK, "update", "--system", "--noninteractive"], timeout=PROVIDER_TIMEOUT)
        state = "SUCCESS" if result.returncode == 0 else "DEGRADED"
        reason = "System applications were updated through Flatpak." if result.returncode == 0 else "System Flatpak reported a failure."
        results.append({"provider": "Flatpak (system)", "state": state, "reason": reason})
        emit("provider", **results[-1])

    if args.firmware:
        emit("phase", phase="UPDATING_FIRMWARE", message="Applying the available firmware updates.")
        result = run([FWUPD, "update", "--assume-yes"], timeout=PROVIDER_TIMEOUT)
        state = "SUCCESS" if result.returncode == 0 else "DEGRADED"
        reason = "Firmware updates completed through fwupd." if result.returncode == 0 else "fwupd reported a failure."
        results.append({"provider": "fwupd", "state": state, "reason": reason})
        emit("provider", **results[-1])

    emit(
        "complete",
        recovery_point={"id": recovery_point["id"], "status": recovery_point["status"]} if recovery_point else None,
        optional_repo_skipped=optional_repo_skipped,
        provider_results=results,
    )
    return 0


def privileged_worker(args):
    """PID 1 owns privileged execution after the fixed Polkit authorization.

    Root UID inside an enrolled application domain still lacks administrative
    MAC rights. Transfer only this validated plan over a root-only activation
    socket; never grant ordinary applications administrative service control.
    """
    if os.geteuid() != 0:
        raise RuntimeError("The update action requires authenticated root authority.")
    if not OPERATION_ID.fullmatch(args.operation_id):
        raise ValueError("invalid update operation id")
    packages = validate_driver_packages(getattr(args, "driver_package", []))
    if args.command == "apply" and (not (args.system or args.system_flatpak or args.firmware) or (packages and not args.system)):
        raise ValueError("invalid privileged update provider plan")
    if args.worker:
        context = Path('/proc/self/attr/current').read_text().strip('\0\n')
        if os.getppid() != 1 or not context.startswith('system_u:system_r:'):
            raise RuntimeError("The update worker requires root system-service authority.")
        with socket.fromfd(0, socket.AF_UNIX, socket.SOCK_STREAM) as peer:
            _pid, uid, _gid = struct.unpack('3i', peer.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if uid != 0:
            raise RuntimeError("The update worker requires an authenticated root peer.")
        if args.command == "check":
            load_recovery_create()  # Load only the installed root-owned module.
            from greyward_security_context.recovery import ensure_btrfs_root
            from greyward_security_context.dms_compatibility import constraints
            ensure_btrfs_root()
            constraints()
            emit("preflight", state="AVAILABLE")
            return 0
        return apply(args)
    command = [args.command, "--operation-id", args.operation_id]
    if args.command == "apply":
        for name, flag in (("system", "--system"), ("system_flatpak", "--system-flatpak"), ("firmware", "--firmware")):
            if getattr(args, name):
                command.append(flag)
        for package in packages:
            command.extend(("--driver-package", package))
    result = None
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as worker:
        worker.settimeout(PROVIDER_TIMEOUT * 3 + 660)
        worker.connect(WORKER_SOCKET)
        worker.sendall(json.dumps(command).encode('utf-8') + b'\n')
        worker.shutdown(socket.SHUT_WR)
        with worker.makefile('r', encoding='utf-8') as output:
            for line in output:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    event = None
                if isinstance(event, dict) and event.get('greyward_update_event') == 'worker_exit':
                    result = event.get('status')
                else:
                    sys.stdout.write(line)
                    sys.stdout.flush()
    if type(result) is not int or result < 0 or result > 255:
        raise RuntimeError("The root update worker ended without a verified exit status.")
    return result


def main(argv=None):
    arguments = list(sys.argv[1:] if argv is None else argv)
    if arguments == ['serve']:
        # Socket activation supplies a connected descriptor, never a user path.
        if os.geteuid() != 0 or os.getppid() != 1:
            raise RuntimeError("Root socket activation required")
        with socket.fromfd(0, socket.AF_UNIX, socket.SOCK_STREAM) as peer:
            _pid, uid, _gid = struct.unpack('3i', peer.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
            if uid != 0:
                raise RuntimeError("Authenticated root peer required")
            peer.settimeout(10)
            with peer.makefile('rb') as request:
                payload = request.readline(16385)
        if len(payload) > 16384 or not payload.endswith(b'\n'):
            raise ValueError("Invalid update request size")
        request = json.loads(payload)
        if (not isinstance(request, list) or not request or request[0] not in ('apply', 'check')
                or len(request) > 72 or any(not isinstance(v, str) or len(v) > 240 for v in request)
                or '--worker' in request):
            raise ValueError("Invalid update worker request")
        status = main([*request, '--worker'])
        emit('worker_exit', status=status)
        return status
    parser = argparse.ArgumentParser(description="GREYWARD fixed native-provider update transaction")
    subparsers = parser.add_subparsers(dest="command", required=True)
    apply_parser = subparsers.add_parser("apply")
    apply_parser.add_argument("--operation-id", required=True)
    apply_parser.add_argument("--system", action="store_true")
    apply_parser.add_argument("--system-flatpak", action="store_true")
    apply_parser.add_argument("--firmware", action="store_true")
    apply_parser.add_argument("--driver-package", action="append", default=[])
    apply_parser.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
    check_parser = subparsers.add_parser("check", help="Check privileged recovery and desktop policy readiness without preparing updates")
    check_parser.add_argument("--operation-id", required=True)
    check_parser.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args(arguments)
    try:
        return privileged_worker(args)
    except (OSError, subprocess.SubprocessError, RuntimeError, ValueError) as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
