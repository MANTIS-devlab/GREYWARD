[Unit]
Description=GREYWARD Update Center native provider aggregation and orchestration
After=graphical-session-pre.target
ConditionUser=!root

[Service]
Type=dbus
BusName=org.greyward.Update1
ExecStart=/usr/libexec/greyward-update-center
Restart=on-failure

[Install]
WantedBy=graphical-session.target
