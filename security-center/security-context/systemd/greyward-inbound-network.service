[Unit]
Description=Import GREYWARD incoming network evidence
After=systemd-journald.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /usr/lib/greyward-security-context/greyward-inbound-network
RuntimeDirectory=greyward-inbound-network
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=15s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/greyward-security-context
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
