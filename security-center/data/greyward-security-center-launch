#!/usr/bin/env bash
set -euo pipefail

# Durable desktop-entry fallback for the last package installed in the VM.
readonly APP=/usr/bin/greyward-security-center

if [[ ! -x "$APP" ]]; then
    printf '%s\n' 'GREYWARD Security Center is not installed.' >&2
    exit 127
fi

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [[ -z "${WAYLAND_DISPLAY:-}" && -d "$XDG_RUNTIME_DIR" ]]; then
    wayland_socket=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' -printf '%f\n' -quit 2>/dev/null || true)
    if [[ -n "$wayland_socket" ]]; then
        export WAYLAND_DISPLAY="$wayland_socket"
    fi
fi
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "$XDG_RUNTIME_DIR/bus" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

# Tao's normal Wayland GtkHeaderBar forces client-side decoration.
# This scoped flag lets Labwc negotiate the native server-side titlebar.
export GREYWARD_LABWC_SERVER_DECORATIONS=1
# GTK otherwise installs a client-side header bar; let labwc own the native frame.
export GTK_CSD=0

# Hyper-V's display-only DRM device has no accelerated 3D renderer. WebKit's
# threaded GL compositor otherwise runs through llvmpipe even for a static
# modal. Keep the native CPU painting path on that hardware; never disable
# sandboxing or alter the compositor/SELinux boundary to obtain acceleration.
greyward_software_compositing() {
    [[ $# -gt 0 ]] || return 1
    local driver
    for driver in "$@"; do
        [[ "$driver" == hyperv_drm ]] || return 1
    done
    return 0
}
if [[ ! ${WEBKIT_DISABLE_COMPOSITING_MODE+x} ]]; then
    drivers=()
    for card in /sys/class/drm/card[0-9]*; do
        [[ "${card##*/}" =~ ^card[0-9]+$ ]] || continue
        driver=$(readlink "$card/device/driver" 2>/dev/null || true)
        drivers+=("${driver##*/}")
    done
    if greyward_software_compositing "${drivers[@]}"; then
        export WEBKIT_DISABLE_COMPOSITING_MODE=1
    fi
    unset card driver drivers
fi

if [[ "${1:-}" == "--file-context" && -n "${2:-}" ]]; then
    export GREYWARD_CONTEXT_FILE="$2"
    shift 2
fi

exec "$APP" "$@"
