# Experimental read-only broker. No preset or D-Bus activation is shipped.
[Unit]
Description=GREYWARD Application Security broker (experimental read API)
After=dbus.service

[Service]
Type=simple
ExecStart=/usr/libexec/greyward-application-security
User=root
Group=root
UMask=0077
StateDirectory=greyward/application-security
StateDirectoryMode=0700
RuntimeDirectory=greyward-application-security
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @raw-io @obsolete
TasksMax=16
MemoryHigh=64M
MemoryMax=128M
CPUQuota=100%
LimitNOFILE=256
TimeoutStartSec=10
TimeoutStopSec=5
Restart=on-failure
RestartSec=5

# Release policy domains, providers and enrollment are not supplied by this
# experimental package. Do not enable it as application protection.
