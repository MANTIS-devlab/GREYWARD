+/* Only a real post-unlock pixel-buffer commit clears the protected-frame
+ * barrier. Mode/damage-only events and abandoned locks never clear it. */
+static void
+handle_screenshot_commit(struct wl_listener *listener, void *data)
+{
+ struct output *output=wl_container_of(listener,output,screenshot_commit);
+ struct wlr_output_event_commit *event=data;
+ struct session_lock_manager *manager=output->server->session_lock_manager;
+ if (!manager || manager->locked) output->screenshot_clean=false;
+ else if (event->state->committed & WLR_OUTPUT_STATE_BUFFER) output->screenshot_clean=true;
+}
