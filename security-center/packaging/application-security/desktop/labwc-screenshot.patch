+
+/* A physical Print press creates one private, short-lived screenshot channel.
+ * No ordinary registry gets capture globals, and no app_id/env/IPC is authority.
+ * The child remains ordinary; this exact server-owned wl_client is the grant.
+ * A retained/stolen child FD has only this protocol allowlist and deadline. */
+struct greyward_capture {
+ struct wl_client *client;
+ struct wl_listener destroy;
+ struct wl_event_source *deadline;
+ struct wl_list link;
+};
+static struct wl_list greyward_captures = { &greyward_captures, &greyward_captures };
+
+static struct greyward_capture *
+greyward_capture_client(const struct wl_client *client)
+{
+ struct greyward_capture *capture;
+ wl_list_for_each(capture, &greyward_captures, link) {
+  if (capture->client == client) return capture;
+ }
+ return NULL;
+}
+
+static bool
+greyward_capture_ready(struct server *server)
+{
+ if (!server->session_lock_manager || server->session_lock_manager->locked) return false;
+ bool found=false;
+ struct output *output;
+ wl_list_for_each(output, &server->outputs, link) {
+  if (!output->wlr_output->enabled) continue;
+  found=true;
+  if (!output->screenshot_clean) return false;
+ }
+ return found;
+}
+
+static bool
+greyward_capture_protocol(const struct wl_interface *iface)
+{
+ const char *const names[] = { "wl_shm", "wl_output", "zxdg_output_manager_v1",
+  "zwlr_screencopy_manager_v1" };
+ for (size_t i=0; i<ARRAY_SIZE(names); ++i) {
+  if (!strcmp(iface->name, names[i])) return true;
+ }
+ return false;
+}
+
+static void
+greyward_capture_destroy(struct wl_listener *listener, void *data)
+{
+ (void)data;
+ struct greyward_capture *capture = wl_container_of(listener, capture, destroy);
+ if (capture->deadline) wl_event_source_remove(capture->deadline);
+ wl_list_remove(&capture->destroy.link);
+ wl_list_remove(&capture->link);
+ free(capture);
+}
+
+static int
+greyward_capture_expire(void *data)
+{
+ struct greyward_capture *capture = data;
+ wl_client_destroy(capture->client);
+ return 0;
+}
+
+void
+greyward_screenshot_revoke(struct server *server)
+{
+ /* An unlocked flag is insufficient: old scanout may still contain a lock
+  * image. Require a fresh ordinary BUFFER commit on every enabled output. */
+ struct output *output;
+ wl_list_for_each(output, &server->outputs, link) {
+  output->screenshot_clean=false;
+  if (output->scene_output) {
+   wlr_damage_ring_add_whole(&output->scene_output->damage_ring);
+   wlr_output_schedule_frame(output->wlr_output);
+  }
+ }
+ while (!wl_list_empty(&greyward_captures)) {
+  struct greyward_capture *capture = wl_container_of(greyward_captures.next, capture, link);
+  wl_client_destroy(capture->client);
+ }
+}
+
+void
+greyward_screenshot_start(struct server *server)
+{
+ /* Fail closed during startup, abandoned locks and authentication locks. */
+ if (!greyward_capture_ready(server) || !wl_list_empty(&greyward_captures)) return;
+ int pair[2];
+ if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, pair) != 0) return;
+ struct greyward_capture *capture = calloc(1, sizeof(*capture));
+ if (!capture) { close(pair[0]); close(pair[1]); return; }
+ capture->client = wl_client_create(server->wl_display, pair[0]);
+ if (!capture->client) { close(pair[0]); close(pair[1]); free(capture); return; }
+ capture->destroy.notify = greyward_capture_destroy;
+ wl_client_add_destroy_listener(capture->client, &capture->destroy);
+ wl_list_insert(&greyward_captures, &capture->link);
+ capture->deadline = wl_event_loop_add_timer(server->wl_event_loop,
+  greyward_capture_expire, capture);
+ if (!capture->deadline || wl_event_source_timer_update(capture->deadline, 3000) < 0) {
+  close(pair[1]); wl_client_destroy(capture->client); return;
+ }
+ extern char **environ;
+ size_t count=0;
+ while (environ[count]) ++count;
+ char **env = calloc(count+2, sizeof(*env));
+ if (!env) { close(pair[1]); wl_client_destroy(capture->client); return; }
+ size_t n=0;
+ for (size_t i=0; i<count; ++i) {
+  if (strncmp(environ[i], "WAYLAND_SOCKET=", 15)) env[n++]=environ[i];
+ }
+ env[n]="WAYLAND_SOCKET=3";
+ posix_spawn_file_actions_t actions;
+ int result=posix_spawn_file_actions_init(&actions);
+ if (!result) {
+  result=posix_spawn_file_actions_adddup2(&actions, pair[1], 3);
+  if (!result) result=posix_spawn_file_actions_addclosefrom_np(&actions, 4);
+  pid_t pid;
+  char *const argv[]={ "/usr/bin/python3", "-I", "/usr/local/libexec/greyward-screenshot", "--capture", NULL };
+  if (!result) result=posix_spawn(&pid, argv[0], &actions, NULL, argv, env);
+  posix_spawn_file_actions_destroy(&actions);
+ }
+ free(env);
+ close(pair[1]);
+ if (result) {
+  wlr_log(WLR_ERROR, "GREYWARD screenshot launch failed: %s", strerror(result));
+  wl_client_destroy(capture->client);
+ }
+}
