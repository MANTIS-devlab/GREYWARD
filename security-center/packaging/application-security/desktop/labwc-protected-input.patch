 }
 
+/* Kernel socket identity, never app_id, PID titles or client-supplied metadata.
+ * Privileged clients are fixed root-prepared authentication/display subjects.
+ * Ordinary clients keep desktop chrome, but never input, capture or lock rights.
+ * Security-context clients retain upstream's stricter allowlist above. */
+static bool
+greyward_client_domain(const struct wl_client *client, const char *expected)
+{
+	char context[256] = {0};
+	socklen_t size = sizeof(context) - 1;
+	if (getsockopt(wl_client_get_fd((struct wl_client *)client), SOL_SOCKET,
+			SO_PEERSEC, context, &size) != 0 || size >= sizeof(context)) {
+		return false;
+	}
+	context[size] = '\0';
+	return !strcmp(context, expected);
+}
+
+static bool
+greyward_ordinary_protocol(const struct wl_interface *iface)
+{
+	if (allow_for_sandbox(NULL, iface)) {
+		return true;
+	}
+	static const char * const chrome[] = {
+		"zwlr_layer_shell_v1", "zwlr_foreign_toplevel_manager_v1",
+		"ext_foreign_toplevel_list_v1", "ext_idle_notifier_v1",
+		"ext_workspace_manager_v1", "zcosmic_workspace_manager_v1",
+	};
+	for (size_t i = 0; i < ARRAY_SIZE(chrome); i++) {
+		if (!strcmp(iface->name, chrome[i])) {
+			return true;
+		}
+	}
+	return false;
+}
+
 static bool
