# Explicit development activation; no automatic account enrollment or preset.
[Unit]
Description=GREYWARD Application Security managed workflows
After=dbus.service
Conflicts=greyward-application-security.service

[Service]
Type=dbus
BusName=systems.mantis.greyward.ApplicationSecurity1
ExecStart=/usr/libexec/greyward-application-security --workflows
User=root
Group=root
UMask=0077
StateDirectory=greyward/application-security
StateDirectoryMode=0700
RuntimeDirectory=greyward-application-security
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
# PID 1 creates each disposable home inside the separate unprivileged
# workload's mount namespace. Broker scratch contains only fixed inputs.
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@reboot @swap @raw-io @obsolete
TasksMax=64
MemoryHigh=256M
MemoryMax=512M
CPUQuota=100%
LimitNOFILE=512
TimeoutStartSec=10
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
