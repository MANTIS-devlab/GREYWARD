{
  "schema": "greyward.publication-policy/v1",
  "excludedPaths": [
    ".codex-attachments/*",
    "environment/greyward.pkr.hcl",
    "environment/http/greyward-dev-bootstrap.ks.tmpl",
    "environment/http/greyward-dev-boottest.ks.tmpl",
    "environment/http/greyward.ks.tmpl",
    "environment/http/greyward-boottest.ks.tmpl",
    "environment/development/provision-overlay.sh",
    "tools/greyward-dev/*.ps1",
    "docs/history/*",
    "docs/audit/*",
    "docs/history/security-center/captures/*",
    "tests/security/*",
    "output/*",
    ".secrets/*",
    ".vmtest/*",
    "desktop-*.png",
    "vmconnect*.png",
    "security-center-fixed.png",
    "docs/assets/screenshots/greyward-desktop-browser.png",
    "docs/assets/screenshots/greyward-desktop-threat-notification.png",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*.kdbx",
    ".env",
    ".env.*",
    "id_rsa",
    "id_ed25519"
  ],
  "retainedHistoryIndex": "docs/history/README.md",
  "publicTemplates": {
    "docs/PUBLICATION.md": "tools/publication-templates/publication.md",
    "docs/development/DEVELOPMENT.md": "tools/publication-templates/development.md",
    "environment/development/README.md": "tools/publication-templates/development-boundary.md",
    "docs/architecture/ISO_CREATION.md": "tools/publication-templates/iso-source-build.md",
    "docs/architecture/ISO_REBUILD_QUICKSTART.md": "tools/publication-templates/iso-quickstart.md"
  },
  "requiredPaths": [
    "AGENTS.md",
    "docs/INDEX.md",
    "docs/STATUS.md",
    "docs/REPOSITORY_MAP.md",
    "environment/image/build-iso.sh",
    "environment/image/build-components.py",
    "environment/image/verify-usbguard-inputs.py",
    "environment/development/build-security-center.sh",
    "environment/production/provision.sh",
    "environment/production/dms-release.json",
    "packaging/greyward-enrollment/greyward-enrollment.spec",
    "security-center/Cargo.lock",
    "security-center/tauri/package-lock.json"
  ]
}
