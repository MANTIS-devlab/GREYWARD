* text=auto
*.sh text eol=lf
*.svg text eol=lf
*.qml text eol=lf
*.json text eol=lf
*.hcl text eol=lf
*.tmpl text eol=lf
*.ps1 text eol=crlf
*.py text eol=lf
*.rs text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.md text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
environment/patches/dms/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
spikes/application-security/portal/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Unified diff context columns preserve upstream tabs and empty lines verbatim.
security-center/packaging/application-security/desktop/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
packaging/greyward-files/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
environment/session/greyward-* text eol=lf
environment/production/greyward-* text eol=lf
security-center/security-context/bin/* text eol=lf
environment/session/labwc/autostart text eol=lf
environment/production/labwc-autostart text eol=lf
packaging/greyward-dms/*.spec text eol=lf
packaging/greyward-session/*.spec text eol=lf
packaging/greyward-enrollment/*.spec text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary

# The sudo handoff is an extensionless Python executable. Its shebang passes
# Python's isolated-mode option, so the CR from Windows line endings is fatal.
security-center/packaging/application-security/administration/sudo-handoff text eol=lf
security-center/packaging/application-security/greyward-application-security-experimental.spec text eol=lf
